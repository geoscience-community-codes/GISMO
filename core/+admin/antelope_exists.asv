function TF = antelope_exists()
%ANTELOPE_EXISTS  Simple check: use ANTELOPE env var and run its setup.m.
%   TF = admin.antelope_exists()

TF = false;

% If already available on path, done
if exist('dbopen.m','file') == 2 && exist('trload_css.m','file') == 2
    TF = true;
    return
end
1

% Require ANTELOPE env var
ant_env = getenv('ANTELOPE');
if isempty(ant_env)
    return
end
ant_env = char(ant_env);
fprintf('ANTELOPE=%s',ant_env)
2

% Ensure folder exists and setup.m is present
setup_m = fullfile(ant_env,'setup.m');
disp(setup_m)
if exist(setup_m,'file')
    addpath(ant_env)
    which setup
    setup()

    % Final verification
    TF = (exist('dbopen.m','file') == 2) && (exist('trload_css.m','file') == 2);
end